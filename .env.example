# Vercel: set these in Project Settings > Environment Variables

# Database (cPanel MySQL) — easiest: copy DATABASE_URL from the hit-by-huma-store project
DATABASE_URL=mysql://user:password@host:3306/database

# Or set individual vars instead (ignored when DATABASE_URL is present):
# DB_HOST=your-cpanel-host.example.com
# DB_PORT=3306
# DB_NAME=cpaneluser_hitbyhuma
# DB_USER=cpaneluser_pos
# DB_PASSWORD=your-db-password
DB_SSL=true
DB_POOL_MAX=5

# Auth
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-too-long-random
JWT_REFRESH_EXPIRES_IN=7d

# CORS (production POS domain)
CLIENT_URL=https://pos.hitbyhuma.com

# API prefix (default /api/v1)
API_PREFIX=/api/v1
