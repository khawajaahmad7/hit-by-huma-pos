# cPanel Node.js App — set these in cPanel > Setup Node.js App > Environment Variables
# Or create a .env file in the project root for local dev

# Database (cPanel MySQL — localhost, no firewall issues)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hitbyhuma_pos
DB_USER=hitbyhuma_admin
DB_PASSWORD=your-db-password
DB_SSL=false
DB_POOL_MAX=10

# Auth
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-too-long-random
JWT_REFRESH_EXPIRES_IN=7d

# CORS (production POS domain — set to your cPanel domain)
CLIENT_URL=https://pos.hitbyhuma.com

# API prefix (default /api/v1)
API_PREFIX=/api/v1

# Node environment
NODE_ENV=production
